# Copy to .env and fill in your private values. Never commit .env.
PORT=8081
QIJI_MYSQL_ADDR=127.0.0.1:3306
QIJI_MYSQL_USER=qiji
QIJI_MYSQL_PASSWORD=replace_me
QIJI_MYSQL_DATABASE=qiji_dispatch
QIJI_CREATE_DATABASE=false
QIJI_REDIS_ADDR=127.0.0.1:6379
QIJI_REDIS_PASSWORD=replace_me
# false only for local HTTP; enable behind HTTPS.
QIJI_COOKIE_SECURE=false

